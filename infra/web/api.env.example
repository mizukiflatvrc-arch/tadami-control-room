# Backend runtime only. Copy to api.env (gitignored); chmod 600.
# Values supplied by the user as measured on tadami; API connection still untested.
TCR_PROMETHEUS_URL=http://prometheus:9090/
TCR_METRIC_PROFILE=node-exporter-v1
TCR_HOST_ID=tadami
TCR_HOST_NAME=tadami
TCR_OS_LABEL='Ubuntu Server 24.04.5 LTS'
TCR_PROMETHEUS_JOB=tadami-node
TCR_PROMETHEUS_INSTANCE=tadami
TCR_CPU_RATE_WINDOW_SECONDS=60
TCR_FILESYSTEMS_JSON='[{"id":"root","device":"/dev/nvme0n1p2","mountpoint":"/","fstype":"ext4"}]'
TCR_SERVICES_JSON=[]
TCR_PROMETHEUS_AUTH=none
