# Copy to .env.server. Blank REQUIRED fields deliberately prevent connection.
# This file is loaded ONLY by the Node.js backend, never by the frontend.
TCR_API_PORT=8787
TCR_API_HOST=127.0.0.1
TCR_PROMETHEUS_URL=
# Select node-exporter-v1 only after verifying metrics on the target.
TCR_METRIC_PROFILE=
TCR_HOST_ID=
TCR_HOST_NAME=
TCR_OS_LABEL=OS 未確認
TCR_PROMETHEUS_JOB=
TCR_PROMETHEUS_INSTANCE=
# Confirm the scrape interval before choosing a rate window (30..3600 seconds).
TCR_CPU_RATE_WINDOW_SECONDS=
# REQUIRED exact device/mountpoint/fstype selectors. [] deliberately fails startup.
TCR_FILESYSTEMS_JSON=[]
# Optional list: each item has id, name, expectedState (running|stopped).
# Measurement remains unknown in beta 0.2, including for configured services.
TCR_SERVICES_JSON=[]
TCR_PROMETHEUS_AUTH=none
TCR_PROMETHEUS_TOKEN=
TCR_PROMETHEUS_USERNAME=
TCR_PROMETHEUS_PASSWORD=
